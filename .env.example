# Environment variables for the registration platform.
#
# Nothing in the app reads any of these yet — there's no database, auth,
# or API routes in this phase (see CLAUDE.md / TASKS.md). This file
# exists so the shape is ready when Phase 1 (Prisma + Postgres) and
# Phase 2 (Auth.js) land.
#
# To run locally: copy this file to .env.local and fill in real values
# once those phases are actually wired up. .env.local is gitignored;
# this file is the committed template and should never contain real
# secrets — only empty placeholders or non-sensitive defaults.

# --- Phase 1: Data layer (Postgres via Supabase) ---
# Transaction-mode pooler (IPv4-only) — used by the app at runtime
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session-mode pooler — used for migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --- Phase 2: Auth (not wired up yet — provider unconfirmed, see TASKS.md) ---
# AUTH_SECRET=
