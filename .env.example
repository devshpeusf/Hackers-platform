# Environment variables for the registration platform.
#
# See CLAUDE.md / TASKS.md for what each phase is. This file exists so the
# shape is ready for anyone cloning the repo.
#
# To run locally: copy this file to .env and fill in real values. Both
# the Next.js app and the Prisma CLI (migrate/generate) read .env — one
# file covers both, no separate .env.local needed. .env is gitignored;
# this file is the committed template and should never contain real
# secrets — only empty placeholders or non-sensitive defaults. A fresh
# clone also needs `npx prisma generate` before it builds.

# --- Data layer (Postgres via Supabase) ---
# Transaction-mode pooler (IPv4-only) — used by the app at runtime
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session-mode pooler — used for migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --- Phase 2: Auth + Storage (Supabase Auth, not Auth.js — see TASKS.md decisions log) ---
# Project Settings -> API in the Supabase dashboard. The publishable/anon key
# is safe to expose to the browser (hence NEXT_PUBLIC_); RLS policies are
# what actually protect the data, not secrecy of this key.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# The public origin this app is served from. Set it in Vercel to the custom
# domain — behind their proxy the request's own host is the deployment URL, so
# without this anything we redirect to (including the OAuth callback) moves
# people onto *.vercel.app and strands them there.
#
# Leave unset locally; the request host is correct when nothing is proxying.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://apply.hackjam26.com"

# --- Transactional email (Resend) ---
# Resend dashboard → API Keys. Sending domain mail.hackjam26.com must be
# verified in Resend before sends will actually deliver.
RESEND_API_KEY=
# Where a reply to the confirmation email actually goes — the From address
# is noreply@, so without this a reply has nowhere to land.
REPLY_TO_EMAIL=

# --- Email send queue ---
# Confirmation emails are queued (EmailQueue table), not sent directly, so a
# Resend failure or the free-tier 100/day cap can't silently drop one — see
# src/app/api/jobs/send-queued/route.ts. That route is triggered by an
# external scheduler (cron-job.org), not a Vercel cron — Hobby's plan caps
# cron jobs at once/day, too infrequent for draining this queue.
#
# Shared secret the scheduler must send back in an Authorization header
# (`Bearer <value>`) on every call. Generate with: openssl rand -hex 32
CRON_SECRET=
# How many PENDING rows one invocation sends. Tunable without a deploy —
# lower it if Resend's daily cap needs finer control around a launch spike.
# Optional; defaults to 20 in code if unset.
EMAIL_BATCH_SIZE=
