// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Minimal model to verify the Supabase connection works end-to-end.
// Nothing else lives here yet — see TASKS.md Phase 1 for what's next.
model Ping {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
}

// TABLES START HERE

model Person {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// Discord account id — the identity an application is keyed on. Email is
  /// self-reported and editable, so it can't be the key: someone signing in
  /// again with a different email would become a second Person.
  discordId String @unique

  /// Everyone who signs in is an APPLICANT by default. VOLUNTEER and
  /// ORGANIZER are assigned by hand in the DB; there's no self-serve
  /// promotion path. Volunteers have event-day staff access only where
  /// explicitly allowed; organizer-only access still requires ORGANIZER.
  role PersonRole @default(APPLICANT)

  firstName String
  lastName  String
  email     String @unique

  /// The @handle, shown to teammates on /team. Saved when they create or join
  /// a team (it comes from the Discord login, which only knows the person
  /// currently signed in). Display only — never used for access.
  discordUsername String?
  /// Required — MLH's baseline collection includes phone number. Deliberately
  /// NOT unique though: two applicants can legitimately share a number.
  phoneNum  String

  // One person can have one resume
  resume Resume?

  // One person can submit many applications
  applications Application[] @relation("Applicant")

  /// Applications this person decided, when they're an organizer. Empty for
  /// everyone else.
  decisions Application[] @relation("Decider")
}

model Event {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime

  /// Where the confirmation email sends applicants to complete MLH
  /// registration (a separate, required step this app never owns — see
  /// CLAUDE.md). Read at send time rather than hardcoded so a future event
  /// doesn't inherit this one's link.
  organizerHqUrl String

  /// Hacker guide (/guide). Edited from /admin/event or in Supabase — no
  /// deploy. All optional: an empty field shows "TBA" rather than breaking
  /// the page, so a new event can go live before every detail is known.
  /// Where things happen: a JSON list of { label, place, note?, address? } in
  /// display order — e.g. "Main venue: ENB" and "Ceremonies: CMC". A list, not
  /// one venue field, so next year's setup (a separate food hall, say) is data,
  /// not code. An address gives that place its own Maps link. The first entry
  /// is the main venue (the dashboard header names it). Read through
  /// parseLocations(), which tolerates bad hand-edited JSON.
  locations        Json     @default("[]")
  /// Empty shows "To be announced" in amber on /guide.
  parkingInfo      String?
  /// Free text, not network + password: USF uses eduroam / USF-Guest with no
  /// shared password. Line breaks are kept on the page.
  wifiInfo         String?
  whatToBring      String[] @default([])
  /// Empty falls back to MLH's official Code of Conduct on the page.
  codeOfConductUrl String?
  /// The full hacker guide document (public, e.g. Notion). The fields above
  /// are only the day-of essentials; /guide links here for everything else,
  /// and shows an "in progress" state while it's empty.
  hackerGuideUrl   String?
  /// Where hackers get help (the "Need help?" box on /guide and the
  /// dashboard's contact box). There's no in-app help form: questions go to
  /// Discord, and anything private (a Code of Conduct concern) goes by email.
  discordUrl       String?
  contactEmail     String?

  /// The run of show (/schedule): a JSON list of { time, label, highlighted }
  /// in display order. Edited from /admin/event or by hand in Supabase — no
  /// deploy, so a slip on the day can be fixed live. Empty shows an "in
  /// progress" state. Read through parseSchedule(), which tolerates bad
  /// hand-edited JSON instead of breaking the page.
  schedule         Json     @default("[]")

  // One event can have many applications
  applications Application[]

  // Teams are per event, so next year's start empty.
  teams Team[]
}

// Resume is its own model for reusability
model Resume {
  id         String   @id @default(cuid())
  fileName   String
  storageKey String   @unique
  uploadedAt DateTime @default(now())

  // Connects each resume to one person
  personId String @unique
  person   Person @relation(fields: [personId], references: [id])
}

model Application {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Connects application to a person
  personId String
  person   Person @relation("Applicant", fields: [personId], references: [id])

  /// The hacker's team for this event, if any (/team). Hangs off the
  /// application, not the person, so it's one team per hacker per event.
  /// Cleared automatically if the team is deleted.
  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  // Connects application to an event
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  status ApplicationStatus @default(SUBMITTED)

  /// How this application came to exist (PLAT-56).
  ///
  /// ONLINE is someone who filled in /apply/form. WALK_IN is someone
  /// registered at the door by a volunteer, who never applied and never
  /// answered the review questions — which is why so many columns below are
  /// nullable. Defaulting to ONLINE keeps every row that predates walk-ins
  /// correct without a backfill.
  ///
  /// Read it before trusting an absence: a null `major` on an ONLINE row would
  /// be a bug, on a WALK_IN row it's expected.
  source ApplicationSource @default(ONLINE)

  /// Attendance response, separate from the organizer's admission decision.
  /// Only meaningful while status is ACCEPTED. Public responses are final.
  rsvpStatus      RsvpStatus @default(PENDING)
  rsvpRespondedAt DateTime?

  /// Who marked the decision, and when (PLAT-39). Null while still SUBMITTED —
  /// and on the one row decided by hand in the database before this existed.
  ///
  /// A relation rather than a stored Discord id so the review page can name the
  /// organizer without a second lookup, and "everything X decided" is a query.
  decidedAt   DateTime?
  decidedById String?
  decidedBy   Person?   @relation("Decider", fields: [decidedById], references: [id])

  /// What the check-in QR encodes. Random and opaque — nothing derived from
  /// ids or email — so a badge can't be guessed or forged from public facts.
  /// Created the first time an admitted hacker opens their dashboard (see
  /// src/lib/badge.ts), so it doesn't depend on how acceptance is marked.
  /// Only ever rendered for the signed-in owner; never put in a URL.
  badgeToken String? @unique

  /// Required for everyone — a walk-in is still asked which school they're
  /// from, and MLH's 80%-student reporting needs it.
  school       String
  /// Null on a WALK_IN: the door form takes a typed school and doesn't make
  /// anyone search the 13,103-row catalog.
  schoolSource SchoolSource?
  /// Null on a WALK_IN. Review inputs and logistics we don't stop to collect
  /// at the door — ask later if they're needed.
  major        String?
  graduation   String?
  levelOfStudy String?
  shirtSize    String?

  country       String?
  /// Stored instead of an age: an age column is wrong within a year, and MLH's
  /// 80%-student rule is judged against the event date.
  ///
  /// Null on a WALK_IN — a date picker at the door is the opposite of fast, so
  /// isMinor is asked outright instead of derived from this.
  dateOfBirth   DateTime?
  /// Whether they'll be under 18 at the event. Computed from dateOfBirth for
  /// an ONLINE application — not a self-reported answer, so it can't disagree
  /// with the birthdate above — and asked as a single question at the door.
  /// Required either way: HackJam allows minors (MLH's own Minor Policy covers
  /// them), and this is what flags who needs the extra consent paperwork.
  isMinor       Boolean
  /// Demographics MLH reports on. Optional — nobody is required to answer.
  gender        String?
  raceEthnicity String?

  /// The three short answers. Null on a WALK_IN — these are review inputs,
  /// and a walk-in is admitted at the door rather than reviewed.
  whyAttend String? @db.Text
  whatBuild String? @db.Text
  quirkFact String? @db.Text

  /// Collected during the application itself (decided over the earlier
  /// "post-acceptance dashboard" plan — the dashboard is still 100%
  /// placeholder UI, so this is the actual first real question either way).
  /// "No restriction" is a real selectable option, not the absence of an
  /// answer — for an ONLINE application this is always set, because catering
  /// needs a headcount for everyone and not just people with a restriction.
  /// Null only on a WALK_IN, where nobody is standing at the door working
  /// through a dropdown.
  diet String?

  /// MLH consent. The first two are required by MLH and enforced in the Zod
  /// schema; marketing is opt-in. agreementsAt matters because MLH versions
  /// their wording — knowing WHEN someone agreed is part of the record.
  agreedCodeOfConduct Boolean
  agreedDataSharing   Boolean
  agreedMarketing     Boolean  @default(false)
  agreementsAt        DateTime

  gitHub    String?
  linkedIn  String?
  portfolio String?

  // Every application can have queued emails (confirmation now, more types
  // later — see EmailQueue below).
  emailQueue EmailQueue[]

  /// Retries may issue multiple RSVP links, each scoped to this application.
  rsvpTokens RsvpToken[]

  // Every person can only submit one application to each event
  @@unique([personId, eventId])
  // Listing and counting a team's members.
  @@index([teamId])
}

/// Public RSVP credentials. Only hashes are stored; raw tokens exist in the
/// emailed links. These are separate from badge and authentication tokens.
model RsvpToken {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  tokenHash String @unique

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Set to the event's start when issuing the invitation.
  expiresAt DateTime
  /// Invalidates an invitation, for example when acceptance is withdrawn.
  revokedAt DateTime?

  /// Nonunique: all links for an application must be findable for revocation.
  @@index([applicationId])
}

/// A send queue for transactional email, so a Resend failure — or hitting
/// the free-tier 100/day cap on launch day — can't silently drop an email.
/// submitApplication inserts a PENDING row instead of sending directly; a
/// cron-triggered route (src/app/api/jobs/send-queued) works through it.
/// See that route for the claim/retry/quota-handling logic.
model EmailQueue {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])

  emailType EmailType
  status    EmailStatus @default(PENDING)

  /// Real send attempts only — a Resend rate-limit/quota response doesn't
  /// increment this (it isn't the email's fault, see the send route), so
  /// this stays an honest count of "times we actually tried and it failed."
  attempts  Int     @default(0)
  lastError String?

  /// Same email can't be queued twice for the same application — a retried
  /// submitApplication call (or a future re-queue action) upserts instead
  /// of duplicating.
  @@unique([applicationId, emailType])
  /// What the send route and admin page both query by: oldest PENDING
  /// first, and the status breakdown/list.
  @@index([status, createdAt])
}

enum EmailType {
  CONFIRMATION
  /// Decision emails. Templates exist (emails/); nothing queues these yet —
  /// that belongs to the decision-marking work.
  ACCEPTED
  WAITLISTED
  REJECTED
}

enum EmailStatus {
  PENDING
  /// Transient: a row sits here only for the length of one send attempt,
  /// set by the send route's atomic claim (see that file) so two
  /// overlapping invocations can't pick up and send the same row twice.
  /// Not in the original spec's three-value list — added because the
  /// "claim before sending, idempotent under overlap" requirement needs a
  /// real state to claim INTO; PENDING/SENT/FAILED alone can't express
  /// "another worker already has this one."
  SENDING
  SENT
  FAILED
}

enum PersonRole {
  APPLICANT
  VOLUNTEER
  ORGANIZER
}

// Possible application statuses
/// A hacker team (/team): one row per team. Members are the applications
/// whose teamId points here. Max 3 members, enforced in src/lib/teams.ts.
/// Informational only — official team registration happens on Devpost.
model Team {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// Any member can rename it.
  name String

  /// What teammates share to join. Random, unique, no lookalike characters.
  inviteCode String @unique

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  members Application[]

  @@index([eventId])
}

enum ApplicationStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  WAITLISTED
}

enum RsvpStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum SchoolSource {
  catalog
  manual
}

/// Where an Application came from — see Application.source (PLAT-56).
enum ApplicationSource {
  ONLINE
  WALK_IN
}
