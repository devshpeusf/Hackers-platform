// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Minimal model to verify the Supabase connection works end-to-end.
// Nothing else lives here yet — see TASKS.md Phase 1 for what's next.
model Ping {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
}

// TABLES START HERE

model Person {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// Discord account id — the identity an application is keyed on. Email is
  /// self-reported and editable, so it can't be the key: someone signing in
  /// again with a different email would become a second Person.
  discordId String @unique

  /// Everyone who signs in is an APPLICANT by default. There's no
  /// self-serve path to ORGANIZER — it's set by hand in the DB for the
  /// people running the event. This is the seed for the full organizer
  /// dashboard on the roadmap (see CLAUDE.md); the email queue admin page
  /// is the first thing that reads it.
  role PersonRole @default(APPLICANT)

  firstName String
  lastName  String
  email     String  @unique
  /// Required — MLH's baseline collection includes phone number. Deliberately
  /// NOT unique though: two applicants can legitimately share a number.
  phoneNum  String

  // One person can have one resume
  resume Resume?

  // One person can submit many applications
  applications Application[]
}

model Event {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime

  /// Where the confirmation email sends applicants to complete MLH
  /// registration (a separate, required step this app never owns — see
  /// CLAUDE.md). Read at send time rather than hardcoded so a future event
  /// doesn't inherit this one's link.
  organizerHqUrl String

  // One event can have many applications
  applications Application[]
}

// Resume is its own model for reusability
model Resume {
  id         String   @id @default(cuid())
  fileName   String
  storageKey String   @unique
  uploadedAt DateTime @default(now())

  // Connects each resume to one person
  personId String @unique
  person   Person @relation(fields: [personId], references: [id])
}

model Application {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Connects application to a person
  personId String
  person   Person @relation(fields: [personId], references: [id])

  // Connects application to an event
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  status       ApplicationStatus @default(SUBMITTED)

  school       String
  schoolSource SchoolSource
  major        String
  graduation   String
  levelOfStudy String
  shirtSize    String

  country      String
  /// Stored instead of an age: an age column is wrong within a year, and MLH's
  /// 80%-student rule is judged against the event date.
  dateOfBirth  DateTime
  /// Computed from dateOfBirth vs. the event's start date at submission time
  /// — not a self-reported answer, so it can't disagree with the birthdate
  /// above. HackJam allows minors (MLH's own Minor Policy covers them), this
  /// just flags who needs the extra consent paperwork so a lead can follow
  /// up. No dashboard reads this yet; query/filter directly until one exists.
  isMinor       Boolean
  /// Demographics MLH reports on. Optional — nobody is required to answer.
  gender        String?
  raceEthnicity String?

  /// The three short answers.
  whyAttend String @db.Text
  whatBuild String @db.Text
  quirkFact String @db.Text

  /// Collected during the application itself (decided over the earlier
  /// "post-acceptance dashboard" plan — the dashboard is still 100%
  /// placeholder UI, so this is the actual first real question either way).
  /// "No restriction" is a real selectable option, not the absence of an
  /// answer, so this is required rather than nullable — catering needs a
  /// headcount for everyone, not just people with a restriction.
  diet String

  /// MLH consent. The first two are required by MLH and enforced in the Zod
  /// schema; marketing is opt-in. agreementsAt matters because MLH versions
  /// their wording — knowing WHEN someone agreed is part of the record.
  agreedCodeOfConduct Boolean
  agreedDataSharing   Boolean
  agreedMarketing     Boolean  @default(false)
  agreementsAt        DateTime

  gitHub    String?
  linkedIn  String?
  portfolio String?

  // Every application can have queued emails (confirmation now, more types
  // later — see EmailQueue below).
  emailQueue EmailQueue[]

  // Every person can only submit one application to each event
  @@unique([personId, eventId])
}

/// A send queue for transactional email, so a Resend failure — or hitting
/// the free-tier 100/day cap on launch day — can't silently drop an email.
/// submitApplication inserts a PENDING row instead of sending directly; a
/// cron-triggered route (src/app/api/jobs/send-queued) works through it.
/// See that route for the claim/retry/quota-handling logic.
model EmailQueue {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])

  emailType EmailType
  status    EmailStatus @default(PENDING)

  /// Real send attempts only — a Resend rate-limit/quota response doesn't
  /// increment this (it isn't the email's fault, see the send route), so
  /// this stays an honest count of "times we actually tried and it failed."
  attempts  Int     @default(0)
  lastError String?

  /// Same email can't be queued twice for the same application — a retried
  /// submitApplication call (or a future re-queue action) upserts instead
  /// of duplicating.
  @@unique([applicationId, emailType])
  /// What the send route and admin page both query by: oldest PENDING
  /// first, and the status breakdown/list.
  @@index([status, createdAt])
}

enum EmailType {
  CONFIRMATION
}

enum EmailStatus {
  PENDING
  /// Transient: a row sits here only for the length of one send attempt,
  /// set by the send route's atomic claim (see that file) so two
  /// overlapping invocations can't pick up and send the same row twice.
  /// Not in the original spec's three-value list — added because the
  /// "claim before sending, idempotent under overlap" requirement needs a
  /// real state to claim INTO; PENDING/SENT/FAILED alone can't express
  /// "another worker already has this one."
  SENDING
  SENT
  FAILED
}

enum PersonRole {
  APPLICANT
  ORGANIZER
}

// Possible application statuses
enum ApplicationStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  WAITLISTED
}

enum SchoolSource {
  catalog
  manual
}
