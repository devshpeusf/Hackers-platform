{
  "name": "HackJam Scanner",
  "short_name": "Scanner",
  "description": "Volunteer badge verification for HackJam.",
  "id": "/scanner",
  "start_url": "/scanner",
  "scope": "/scanner",
  "display": "standalone",
  "theme_color": "#07060d",
  "background_color": "#07060d",
  "prefer_related_applications": false,
  "icons": [
    { "src": "/scanner-icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/scanner-icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/scanner-icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/scanner-icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
